{
  "reference": "C:\\Users\\kaku\\Downloads\\TF_UFI_EXPERIMENT_20260806\\noodle_image_benchmark_v1\\paper_release\\output\\pdf\\FoodStateEdit_PreDefense_GUO_2530030_SeniorFormat_20260907.pdf",
  "page_count": 2,
  "japanese_body_size_pt": 9.212,
  "body_leading_pt": 12.752,
  "title_size_pt": 13.266,
  "left_x_pt": 48.905,
  "right_x_pt": 304.724,

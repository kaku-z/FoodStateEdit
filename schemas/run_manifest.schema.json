{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodstateedit.local/schemas/run_manifest.schema.json",
  "title": "FoodStateEdit formal run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "method",
    "seed",
    "model",
    "inference",
    "environment",
    "status",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "foodstateedit.run.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "model": {
      "type": "object",
      "required": ["name", "root", "files"],
      "properties": {
        "name": {"type": "string"},
        "root": {"type": "string"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "size_bytes", "sha256"],
            "properties": {
              "path": {"type": "string"},
              "size_bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "inference": {
      "type": "object",
      "required": ["width", "height", "frames", "steps", "warm_start", "schedule"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frames": {"type": "integer", "minimum": 1},
        "steps": {"type": "integer", "minimum": 1},
        "warm_start": {"type": "boolean"},
        "schedule": {
          "type": "object",
          "required": ["rigid", "contact", "material", "hole"],
          "properties": {
            "rigid": {"type": "integer", "minimum": 0},
            "contact": {"type": "integer", "minimum": 0},
            "material": {"type": "integer", "minimum": 0},
            "hole": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["host", "gpu", "python", "code_commit"],
      "properties": {
        "host": {"type": "string"},
        "gpu": {"type": "string"},
        "python": {"type": "string"},
        "code_commit": {"type": "string"}
      }
    },
    "status": {"enum": ["planned", "running", "complete", "technical_failure", "cancelled"]},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}

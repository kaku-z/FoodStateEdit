{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodstateedit.local/schemas/case_manifest.schema.json",
  "title": "FoodStateEdit case manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "split",
    "source",
    "scene",
    "action",
    "controls",
    "layers",
    "constraints",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "foodstateedit.case.v1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "split": {"enum": ["pilot", "test", "qualitative"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind", "license", "has_target_utensil"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kind": {"enum": ["real", "controlled", "generated"]},
        "license": {"type": "string", "minLength": 1},
        "has_target_utensil": {"const": false},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "scene": {
      "type": "object",
      "required": ["family", "dish", "container", "food_materials"],
      "properties": {
        "family": {"enum": ["liquid", "granular", "strand", "strand_contact"]},
        "dish": {"type": "string"},
        "container": {"type": "string"},
        "food_materials": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["liquid", "granular", "strand", "rigid", "soft_chunk"]}
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["type", "utensil", "payload_relation"],
      "properties": {
        "type": {"enum": ["scoop_liquid", "scoop_payload", "lift_strand", "twirl_and_lift"]},
        "utensil": {"enum": ["spoon", "spatula", "chopsticks", "fork"]},
        "payload_relation": {"type": "string"},
        "amount": {"type": "number", "exclusiveMinimum": 0},
        "amount_unit": {"type": "string"}
      }
    },
    "controls": {
      "type": "object",
      "required": ["contact_anchors", "target_direction", "manual_correction"],
      "properties": {
        "contact_anchors": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}}},
        "target_direction": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}},
        "manual_correction": {"type": "boolean"},
        "annotation_seconds": {"type": "number", "minimum": 0}
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rigid", "contact", "material", "hole", "protect", "edit_alpha"],
      "properties": {
        "rigid": {"type": "string"},
        "contact": {"type": "string"},
        "material": {"type": "string"},
        "hole": {"type": "string"},
        "protect": {"type": "string"},
        "edit_alpha": {"type": "string"}
      }
    },
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "provenance": {
      "type": "object",
      "required": ["builder", "builder_commit", "created_at"],
      "properties": {
        "builder": {"type": "string"},
        "builder_commit": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}

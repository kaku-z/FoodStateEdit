{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodstateedit.local/schemas/adapter_dataset_manifest.schema.json",
  "title": "FoodStateEdit adapter training dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "scientific_status",
    "target_policy",
    "sample_count",
    "metadata",
    "samples",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "foodstateedit.adapter_dataset.v1"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "scientific_status": {
      "enum": [
        "infrastructure_smoke_not_quality_evidence",
        "paired_training_candidate",
        "frozen_training_set",
        "frozen_validation_set"
      ]
    },
    "target_policy": {
      "enum": [
        "deterministic_proxy_identity_plumbing_only",
        "paired_real_photo",
        "paired_disclosed_synthetic_render"
      ]
    },
    "sample_count": {"type": "integer", "minimum": 1},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "columns"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "columns": {
          "type": "array",
          "const": ["video", "vace_video", "vace_reference_image", "prompt"]
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "source_case_id",
          "family",
          "utensil",
          "action",
          "split",
          "leakage_group",
          "target_kind",
          "frame_count",
          "prompt",
          "license",
          "files",
          "hard_constraints",
          "source_proxy_manifest_sha256"
        ],
        "properties": {
          "sample_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
          "source_case_id": {"type": "string"},
          "family": {"enum": ["liquid", "granular", "strand", "strand_contact"]},
          "utensil": {"enum": ["spoon", "spatula", "chopsticks", "fork"]},
          "action": {"enum": ["scoop_liquid", "scoop_payload", "lift_strand", "twirl_and_lift"]},
          "split": {"enum": ["smoke", "train", "validation", "test"]},
          "leakage_group": {"type": "string", "minLength": 1},
          "target_kind": {
            "enum": ["deterministic_proxy", "real_photo", "synthetic_render"]
          },
          "frame_count": {"type": "integer", "minimum": 1},
          "prompt": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "files": {
            "type": "object",
            "additionalProperties": false,
            "required": ["video", "vace_video", "vace_reference_image"],
            "properties": {
              "video": {"$ref": "#/$defs/fileRecord"},
              "vace_video": {"$ref": "#/$defs/fileRecord"},
              "vace_reference_image": {"$ref": "#/$defs/fileRecord"}
            }
          },
          "hard_constraints": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "source_proxy_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder", "builder_sha256", "source_method", "created_at"],
      "properties": {
        "builder": {"type": "string"},
        "builder_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_method": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
